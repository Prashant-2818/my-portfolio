# Prashant Priyadarshi Portfolio Environment Variables
# These variables configure the AI assistant in both local dev and production on Vercel.
# Both are OPTIONAL: if neither is set, the assistant gracefully uses the grounded local RAG engine.

# Port for local Express development server (node server/index.js)
PORT=3001

# Google Gemini API Key (Recommended for live assistant streaming)
# Generate a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative for live assistant completions)
# Generate an API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
